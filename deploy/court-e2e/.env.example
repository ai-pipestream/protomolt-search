# Copy to .env and adjust. All values shown are the defaults.

# rustfs admin credentials (change for anything but a throwaway run).
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_TAG=latest

# CourtListener bulk snapshot to sync (quarterly; see
# https://wiki.free.law/c/courtlistener/help/api/bulk-data/bulk-legal-data).
# The seed job runs aws s3 cp from the public bucket into rustfs.
CL_BUCKET=com-courtlistener-storage
BULK_FILE=opinions-2024-12-31.csv.bz2

# Extraction knobs (run by court_extract in the pipeline, Rust):
# keep EXTRACT_CAP substantive opinions (0 = all), read at most
# EXTRACT_PREFIX_GB GiB of compressed input (0 = all; prefix is biased,
# see README). 50k / 4 GiB is a good test corpus; full = 0 / 0.
EXTRACT_CAP=50000
EXTRACT_MIN_CHARS=1000
EXTRACT_PREFIX_GB=4

# Object store layout.
S3_BUCKET=courtlistener

# Static embedding table the sidecar serves (downloaded by the model job;
# any Model2Vec-layout HF repo works — OpenNLP reads it natively).
MODEL_REPO=minishlab/potion-retrieval-32M
MODEL_NAME=potion-retrieval-32M

# Where to find the grpc-opennlp-analysis repo for the analysis build.
OPENNLP_ANALYSIS_REPO=../../../grpc-opennlp-analysis

# Chunk+embed worker concurrency in the pipeline.
CONCURRENCY=16

# Host port bindings (defaults avoid colliding with other local stacks).
RUSTFS_API_PORT=19000
RUSTFS_CONSOLE_PORT=19001
COORD_PORT=50050
