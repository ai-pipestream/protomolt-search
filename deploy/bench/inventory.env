# shellcheck shell=bash
#
# Bench fleet inventory: the single source of truth for deploy/bench/.
# Sourced by deploy_fleet.sh and run_matrix.sh. Besides the settings it
# provides the host helpers (host_sh, host_ipv4, resolve_pis) and the
# start/stop script generator both scripts share.

# --- fast machines -------------------------------------------------------
# krick is the box this repo lives on (run local, no ssh). krick-1 is the
# 32-core box, reached over ssh (tailscale name in ~/.ssh/config).
FAST_HOSTS=(krick-1 krick)

# ssh target per fast host; empty string means "the local machine".
declare -A BENCH_SSH=(
  [krick-1]=krick-1
  [krick]=""
)

# --- bench output ---------------------------------------------------------
# Defined before the per-host roots so krick's root can live under it.
BENCH_OUT=${BENCH_OUT:-/work/court-corpus/bench}
PROBES=${PROBES:-/work/court-corpus/embeddings-full.bin}

# Bench root per fast host: bin/, run/, logs/, shards/ live under it.
declare -A BENCH_ROOT=(
  [krick-1]=/work/bench
  [krick]="$BENCH_OUT/host-krick"
)

# --- pi fleet ------------------------------------------------------------
# ssh aliases from ~/.ssh/config (user krickert, passwordless). This is the
# full known fleet; resolve_pis probes each one and keeps only the live
# ones, so a powered-down pi is a note on stderr, not a failure. The floor
# scout only needs whichever subset happens to be up.
PI_HOSTS=(pi5v1 pi5v2 pi5v3 pi5v4 pi5v5 cm5v1 cm5v2 cm5ai1 pi500p pi5ai1)

# Bench root on a pi, RELATIVE to the ssh login home directory (kept
# relative so no quoting/tilde expansion games are needed remotely).
PI_REMOTE_DIR=bench-shards

# Per-pi root overrides for hosts whose real storage is not the home
# directory (a full shard is ~57 GB, far more than a 58 GB eMMC root):
#   cm5v1   /work is a 931G NVMe (CT1000P3SSD8)
#   cm5v2   /work is a 238G USB SSD -- no NVMe yet, slower but big enough
#   cm5ai1  eMMC only (~46G free): listed for completeness, but it cannot
#           hold a shard until an NVMe lands; the staging disk preflight
#           refuses it by name.
declare -A PI_ROOT=(
  [cm5v1]=/work/bench-shards
  [cm5v2]=/work/bench-shards
)

# --- ports ---------------------------------------------------------------
# Per host, the n-th shard it serves (n = 0,1,2... per host) gets:
#   sharing node      FLEET_PORT + 2n
#   no-sharing twin   TWIN_PORT + 2n + 1
# so a host serving exactly one shard pair uses 59700/59701, the previous
# fleet's fixed convention. Twins double as hedge replicas.
FLEET_PORT=59700
TWIN_PORT=59701
# Bench coordinator port. Deliberately NOT 59291 -- that is the live v7
# fleet's coordinator on krick and must never be disturbed.
COORD_PORT=59295

# --- shard set -----------------------------------------------------------
# Directory holding shard-<i>.tv + shard-<i>.tv.bm25 pairs, block-aligned
# cuts as built by deploy/v7-rebuild/rebuild.sh.
SHARD_SET=${SHARD_SET:-/work/court-corpus/shards-v9}
# Slot-offset stride the set was built with (i * SLOT_STRIDE per shard).
# Must match the build: `rebuild.sh plan` prints it under "slot_offset".
SLOT_STRIDE=${SLOT_STRIDE:-21659648}
# Index shape, matching the rebuild defaults.
DIM=${DIM:-256}
BIT_WIDTH=${BIT_WIDTH:-4}
CHUNK_BLOCKS=${CHUNK_BLOCKS:-8192}
BM25_FIELDS=${BM25_FIELDS:-body,case_name}

# --- analysis sidecar ----------------------------------------------------
# Every bench node analyzes and embeds against krick's sidecar. IPv4
# literal, never a hostname: a multi-homed IPv6 answer once routed a
# data-plane channel to the wrong machine. Re-derive with `hostname -I`
# on krick (first address) if the LAN renumbers.
SIDECAR_ADDR=${SIDECAR_ADDR:-http://192.168.1.242:59202}
KRICK_IPV4=${KRICK_IPV4:-192.168.1.242}

# --- niceness (the fleet cadence) ----------------------------------------
# Nodes and coordinator run niced so the box stays usable; the sidecar is
# never niced. Pis get +10: their CPUs are the scarce resource.
NICE_FAST=${NICE_FAST:-5}
NICE_PI=${NICE_PI:-10}

# ==========================================================================
# Helpers below. Everything remote goes through host_sh, which pipes the
# script to `bash -s` over ssh: no quoting survives the trip except what
# the script itself quotes, so build scripts with printf %q for values.

# The ssh target for a bench host, or empty for the local machine.
bench_ssh_target() {
  local h=$1
  if [[ -v "BENCH_SSH[$h]" ]]; then
    printf '%s\n' "${BENCH_SSH[$h]}"
  else
    printf '%s\n' "$h"
  fi
}

# q <value>: shell-quote one value for embedding in a remote script.
q() { printf '%q' "$1"; }

# host_sh <host> <script>: run a bash script on a bench host (locally when
# the host is this machine). Fails with the remote's exit status.
host_sh() {
  local host=$1 script=$2 target
  target=$(bench_ssh_target "$host")
  if [[ -z $target ]]; then
    bash -euo pipefail -c "$script"
  else
    printf '%s' "$script" | ssh -o BatchMode=yes -o ConnectTimeout=8 "$target" bash -euo pipefail -s
  fi
}

# host_root <host>: the bench root directory on that host.
host_root() {
  local h=$1
  if [[ -v "BENCH_ROOT[$h]" ]]; then
    printf '%s\n' "${BENCH_ROOT[$h]}"
  elif [[ -v "PI_ROOT[$h]" ]]; then
    printf '%s\n' "${PI_ROOT[$h]}"
  else
    printf '%s\n' "$PI_REMOTE_DIR"
  fi
}

# host_shard_dir <host>: where that host's shard files live. krick serves
# straight from the shard set itself -- it IS the rsync source, and staging
# onto itself would duplicate several hundred GB.
host_shard_dir() {
  local h=$1
  if [[ $h == krick && -z $(bench_ssh_target "$h") ]]; then
    printf '%s\n' "$SHARD_SET"
  else
    printf '%s/shards\n' "$(host_root "$h")"
  fi
}

# host_ipv4 <host>: the host's LAN IPv4. gRPC data-plane addresses must
# be pinned to IPv4 literals. Use the source address of the default
# route, NOT `hostname -I | awk '{print $1}'` -- on hosts with docker
# the first address is the docker0 bridge (172.17.0.1).
host_ipv4() {
  local host=$1 target
  target=$(bench_ssh_target "$host")
  if [[ -z $target ]]; then
    printf '%s\n' "$KRICK_IPV4"
  else
    host_sh "$host" "ip -4 route get 1.1.1.1 | awk '{for(i=1;i<=NF;i++) if(\$i==\"src\"){print \$(i+1); exit}}'"
  fi
}

# resolve_pis: probe every PI_HOST, collect the reachable ones into
# LIVE_PIS with their LAN IPv4 in HOST_IP, note the dead ones on stderr.
declare -a LIVE_PIS=()
declare -A HOST_IP=()
resolve_pis() {
  LIVE_PIS=()
  local h ip
  for h in "${PI_HOSTS[@]}"; do
    if ip=$(host_ipv4 "$h" 2>/dev/null) && [[ -n $ip ]]; then
      LIVE_PIS+=("$h")
      HOST_IP[$h]=$ip
    else
      echo "inventory: $h unreachable, skipping" >&2
    fi
  done
  ((${#LIVE_PIS[@]} > 0)) || return 1
}

# bench_gen_scripts <local-outdir> <nice-level>
# Writes start-node.sh and stop-bench.sh into a LOCAL directory; the
# caller rsyncs them to the host's bench root. The nice level, sidecar
# address, and index shape are baked in at generation time.
bench_gen_scripts() {
  local out=$1 nice=$2
  mkdir -p "$out"
  cat >"$out/start-node.sh" <<'SCRIPT'
#!/usr/bin/env bash
# Generated by deploy/bench (bench_gen_scripts). Do not edit on the host.
# usage: start-node.sh <index.tv> <port> <slot-offset> <sharing:true|false>
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INDEX=${1:?usage: start-node.sh <index.tv> <port> <slot-offset> <sharing:true|false>}
PORT=${2:?port}
OFFSET=${3:?slot offset}
SHARING=${4:?sharing true|false}
case $SHARING in
  true | false) ;;
  *) echo "sharing must be true or false" >&2; exit 2 ;;
esac
mode=twin
[[ $SHARING == true ]] && mode=share
NAME="bench-node-$(basename "$INDEX" .tv)-$mode"
mkdir -p "$DIR/run" "$DIR/logs"
if [[ -f $DIR/run/$NAME.pid ]] && kill -0 "$(cat "$DIR/run/$NAME.pid")" 2>/dev/null; then
  echo "$NAME already running (pid $(cat "$DIR/run/$NAME.pid"))"
  exit 0
fi
nice -n __NICE__ "$DIR/bin/turbovec-search" --role=node \
  --node-listen="0.0.0.0:$PORT" \
  --index="$INDEX" \
  --slot-offset="$OFFSET" \
  --chunk-blocks=__CHUNK_BLOCKS__ \
  --dim=__DIM__ --bit-width=__BIT_WIDTH__ \
  --bm25-fields=__BM25_FIELDS__ \
  --stream-search \
  --floor-sharing="$SHARING" \
  --analysis-addr="__SIDECAR_ADDR__" \
  >>"$DIR/logs/$NAME.log" 2>&1 &
pid=$!
echo "$pid" >"$DIR/run/$NAME.pid"
# An open port is only proof the process is up: a node binds before it has
# opened its .bm25. True readiness is the coordinator-level v7_verify
# --ready-only poll in run_matrix.sh.
for _ in $(seq 1 600); do
  if (exec 3<>"/dev/tcp/127.0.0.1/$PORT") 2>/dev/null; then
    echo "$NAME on :$PORT (pid $pid)"
    exit 0
  fi
  kill -0 "$pid" 2>/dev/null || { echo "$NAME exited; see $DIR/logs/$NAME.log" >&2; exit 1; }
  sleep 2
done
echo "$NAME never opened :$PORT" >&2
exit 1
SCRIPT
  cat >"$out/stop-bench.sh" <<'SCRIPT'
#!/usr/bin/env bash
# Generated by deploy/bench (bench_gen_scripts). Do not edit on the host.
# Stops everything the bench suite started on this host -- and only that:
# it touches nothing but bench-*.pid pidfiles under its own run/ directory.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
shopt -s nullglob
pids=()
for f in "$DIR"/run/bench-*.pid; do
  pid=$(cat "$f")
  if kill -0 "$pid" 2>/dev/null; then
    echo "stopping $(basename "$f" .pid) (pid $pid); it flushes on the way out"
    kill "$pid"
    pids+=("$pid")
  fi
  rm -f "$f"
done
for pid in "${pids[@]:-}"; do
  [[ -n $pid ]] || continue
  for _ in $(seq 1 60); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 2
  done
  if kill -0 "$pid" 2>/dev/null; then
    echo "pid $pid would not exit in 120s; killing" >&2
    kill -9 "$pid"
  fi
done
SCRIPT
  sed -i \
    -e "s|__NICE__|$nice|" \
    -e "s|__SIDECAR_ADDR__|$SIDECAR_ADDR|" \
    -e "s|__CHUNK_BLOCKS__|$CHUNK_BLOCKS|" \
    -e "s|__DIM__|$DIM|" \
    -e "s|__BIT_WIDTH__|$BIT_WIDTH|" \
    -e "s|__BM25_FIELDS__|$BM25_FIELDS|" \
    "$out/start-node.sh"
  chmod +x "$out/start-node.sh" "$out/stop-bench.sh"
}
