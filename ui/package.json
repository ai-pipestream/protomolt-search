{
  "name": "protomolt-search-console-ui",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "The search console's browser client: Connect-ES calls to the console's BFF service, bundled into src/bin/console-ui.",
  "scripts": {
    "gen": "scripts/gen.sh",
    "gen:check": "scripts/gen.sh --check",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --outfile ../src/bin/console-ui/bff.js --target browser --format esm --minify",
    "test": "bun test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.9.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0",
    "eventsource-parser": "^4.1.3"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@types/bun": "1.3.14",
    "typescript": "^5.9.3"
  }
}
