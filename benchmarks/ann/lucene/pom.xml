<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <!-- Dev tooling for the #53 ANN gate: Lucene HNSW (stock, or another
       locally installed build) over the shared fixture directory. Never a
       product dependency. -->
  <groupId>ai.pipestream</groupId>
  <artifactId>protomolt-ann-bench-lucene</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- The stock Lucene release the harness measures as lucene-hnsw. -->
    <lucene.stock.version>10.6.0</lucene.stock.version>
    <!-- Override with -Dlucene.version=... to run another locally installed
         build, such as the shared-floor code of apache/lucene PR #16357 (for
         apache/lucene issue #16958), and name it with -Dlucene.engine=...,
         such as lucene-hnsw-16357. The runner refuses a non-stock version
         under the stock name and the stock version under another name. -->
    <lucene.version>${lucene.stock.version}</lucene.version>
    <lucene.engine>lucene-hnsw</lucene.engine>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.lucene</groupId>
      <artifactId>lucene-core</artifactId>
      <version>${lucene.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.20.0</version>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>classpath</id>
            <phase>package</phase>
            <goals><goal>build-classpath</goal></goals>
            <configuration>
              <outputFile>${project.build.directory}/classpath.txt</outputFile>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
